# Placeholders only. Never commit a real value; this repository is public.

# The API connects as app_runtime (no table ownership, no BYPASSRLS).
DATABASE_URL=postgres://app_runtime:CHANGE_ME@localhost:5432/mbs

# The migration runner must use a role allowed to create schemas and functions.
# MIGRATOR_DATABASE_URL=postgres://mbs_migrator:CHANGE_ME@localhost:5432/mbs

PORT=4000
DB_POOL_MAX=10

# Cookie `Secure` is on unless this is explicitly "true" (local HTTP only).
MBS_INSECURE_COOKIES=false
