{
  "name": "mbs",
  "version": "0.1.0",
  "private": true,
  "description": "Mooral Business Suite — multi-tenant ERP for Bangladeshi businesses",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:repo": "node tools/check-repo.mjs",
    "check:rls": "node tools/check-rls.mjs",
    "verify:schema": "node tools/verify-schema.mjs",
    "spike:rls": "node tools/spikes/rls-pglite.mjs",
    "migrate": "node tools/migrate.mjs",
    "start:api": "node apps/api/src/index.ts",
    "test:money": "node --test packages/domain/test/money.test.ts",
    "test:auth": "node --test packages/domain/test/auth.test.ts",
    "test:data": "node --test packages/data/test/migrator.test.ts",
    "test:api": "node --test apps/api/test/api.test.ts",
    "test": "npm run test:money && npm run test:auth && npm run test:data && npm run test:api",
    "verify": "npm run check:repo && npm run check:rls && npm run verify:schema && npm test"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "hash-wasm": "^4.13.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16"
  }
}
